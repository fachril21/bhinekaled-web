# Copy file ini jadi .env.local dan isi dengan nilai asli dari dashboard Supabase.
# JANGAN commit .env.local ke git.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — JANGAN PERNAH pakai di client component / kode yang bisa
# ke-bundle ke browser.
SUPABASE_SERVICE_ROLE_KEY=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Epic 12: Cek Ongkir Real-Time (RajaOngkir) — semua server-only, TIDAK ADA
# yang prefix NEXT_PUBLIC_.
RAJAONGKIR_API_KEY=
# Kosongkan untuk pakai default kode district asal toko "63181" (lihat
# lib/checkout-config.ts getShippingOriginId()) — isi di sini kalau toko
# pindah lokasi.
SHIPPING_ORIGIN_ID=
SHIPPING_ORIGIN_LABEL=
SHIPPING_COURIER_SET=jne:jnt:sicepat
SHIPPING_WEIGHT_BUCKET_GRAM=100
SHIPPING_RATE_CACHE_TTL_HOURS=12

# Epic 13: Midtrans Payment Integration (Snap Redirect) — semua server-only,
# TIDAK ADA yang prefix NEXT_PUBLIC_. MIDTRANS_SERVER_KEY wajib diisi
# (Sandbox dulu) sebelum endpoint pembayaran bisa berfungsi.
MIDTRANS_SERVER_KEY=
# Tidak dipakai di Redirect mode (hanya untuk snap.js/Pop-up mode), tetap
# disimpan sesuai rekomendasi PRD untuk kebutuhan masa depan.
MIDTRANS_CLIENT_KEY=
# false/kosong = Sandbox. Satu-satunya switch Sandbox<->Production
# (lib/payments/midtrans-config.ts isMidtransProduction()).
MIDTRANS_IS_PRODUCTION=false
